# Node A (party 0: the leader; its worker opens the Signal connection and listens for node B's
# workers). Copy to node.env next to node.yml. Placeholders only: no real host, key or account.
IMAGE=registry.example/tls-mpc-node@sha256:CHANGE-ME
EXPECTED_MANIFEST_SHA256=CHANGE-ME-64-hex-from-build_artifacts.py-circuits
EXPECTED_WORD_DIR_SHA256=CHANGE-ME-64-hex-from-build_artifacts.py-word
NODE_MEMORY=28g
NODE_CONFIG_DIR=/srv/tls-mpc-host/config
NODE_SECRETS_DIR=/srv/tls-mpc-host/secrets
NODE_STATE_DIR=/srv/tls-mpc-host/state
NODE_SCAFFOLD_DIR=/srv/tls-mpc-host/scaffold
CIRCUITS_DIR=/srv/tls-mpc-host/circuits
WORD_DIR=/srv/tls-mpc-host/word
