# Node B (party 1: dials node A's workers; opens no Signal connection). Copy to node.env next to
# node.yml on node B's host. Must name the SAME image digest, manifest digest and word-dir digest
# as node A (verify_artifacts.py compare). Placeholders only.
IMAGE=registry.example/tls-mpc-node@sha256:CHANGE-ME
EXPECTED_MANIFEST_SHA256=CHANGE-ME-64-hex-same-as-node-a
EXPECTED_WORD_DIR_SHA256=CHANGE-ME-64-hex-same-as-node-a
NODE_MEMORY=28g
NODE_CONFIG_DIR=/srv/tls-mpc-host/config
NODE_SECRETS_DIR=/srv/tls-mpc-host/secrets
NODE_STATE_DIR=/srv/tls-mpc-host/state
NODE_SCAFFOLD_DIR=/srv/tls-mpc-host/scaffold
CIRCUITS_DIR=/srv/tls-mpc-host/circuits
WORD_DIR=/srv/tls-mpc-host/word
