# Fixed private outbox transport remasking. No externally supplied fresh mask.
program.set_security(128)
from Compiler.library import export
from Compiler.GC.types import sbitvec,sbit
from backend_adapter.boolean import load
from backend_adapter.aig_packed import execute_mpc
from handshake_backend import binary_io
image=load(program.args[1]);cap=int(program.args[2])
assert image['input_bits']==8*(cap+8)
def evaluate(inputs,outputs):
    raw=binary_io.read_bits(inputs)
    fresh=[sbit.get_random_bit()for _ in range(32)]
    binary_io.write_bits(outputs,execute_mpc(image,raw+fresh))
evaluate.__name__='tls_binary_tls_websocket_remask_'+str(cap)
function=export(evaluate);BitArray=sbitvec.get_type(1).Array
function(BitArray((cap+4)*8),BitArray((cap+3)*8))
