# Internal private WebSocket response encoder. No externally supplied mask bits.
from Compiler.library import export
from Compiler.GC.types import sbitvec,sbit
from backend_adapter.boolean import load
from backend_adapter.aig_packed import execute_mpc
from handshake_backend import binary_io
image=load(program.args[1])
def evaluate(inputs,outputs):
    raw=binary_io.read_bits(inputs)
    mask=[sbit.get_random_bit() for _ in range(32)]
    binary_io.write_bits(outputs,execute_mpc(image,raw[:32]+mask+raw[32:]))
evaluate.__name__='tls_binary_tls_websocket_control_encode_125'
function=export(evaluate);BitArray=sbitvec.get_type(1).Array
function(BitArray(129*8),BitArray(134*8))
