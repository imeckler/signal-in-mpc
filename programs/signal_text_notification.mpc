# Proved numeric builder; private validity/length/body/timestamp, no opens.
program.set_security(128)
from Compiler.library import export
from Compiler.GC.types import sbitvec
from backend_adapter.boolean import load
from backend_adapter.aig_packed import execute_mpc
from handshake_backend import binary_io
image=load(program.args[1])
if image['name']!='signal-private-text-notification-48-80' or image['input_bits']!=472 or len(image['outputs'])!=720:
    raise ValueError('text notification artifact mismatch')
def build(inputs,outputs):binary_io.write_bits(outputs,execute_mpc(image,binary_io.read_bits(inputs)))
build.__name__='signal_private_text_notification_48_80'
function=export(build);Array=sbitvec.get_type(1).Array
function(Array(472),Array(720))
