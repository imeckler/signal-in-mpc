# Private mixed-DH -> proved SSv1/relay circuit. No raw key/DH is opened.
program.set_security(128)
program.unlimited_compilation()
from Compiler.library import export
from Compiler.types import sint
from Compiler.GC.types import sbitvec
from handshake_backend import binary_io
from handshake_backend.field_dag import load as load_field
from handshake_backend.mixed import (fresh_scalar_fields,execute_secret,field_to_wire_bits,
    wire_bits_to_field,wire_bits_to_scalar_fields)
from backend_adapter.boolean import load
from backend_adapter.aig_packed import execute_mpc
from signal_backend.SealedSenderWork.shape import ServiceShape

field_path,image_path,*dimensions=program.args[1:]
shape=ServiceShape(*map(int,dimensions))
field=load_field(field_path);image=load(image_path)
if (field['input_count']!=257 or image['name']!='signal-private-sealed-relay' or
    image['input_bits']!=shape.boolean_input_bytes*8 or len(image['outputs'])!=shape.output_bytes*8):
    raise ValueError('private service artifact mismatch')

def evaluate(inputs,outputs):
    raw=binary_io.read_bits(inputs)
    sender=wire_bits_to_scalar_fields(raw[:256])
    expected_sender=raw[256:512]
    recipient=raw[512:768]
    point=wire_bits_to_field(recipient,mask_high_bit=True)
    ephemeral=fresh_scalar_fields()
    ephemeral_public=field_to_wire_bits(execute_secret(field,ephemeral+[sint(9)])[0])
    sender_public=field_to_wire_bits(execute_secret(field,sender+[sint(9)])[0])
    ephemeral_dh=field_to_wire_bits(execute_secret(field,ephemeral+[point])[0])
    static_dh=field_to_wire_bits(execute_secret(field,sender+[point])[0])
    end=(96+shape.cert+shape.inner)*8
    bound=(recipient+ephemeral_public+sender_public+ephemeral_dh+static_dh+
           raw[768:end]+expected_sender+raw[end:])
    binary_io.write_bits(outputs,execute_mpc(image,bound))

evaluate.__name__=shape.name
function=export(evaluate)
BitArray=sbitvec.get_type(1).Array
function(BitArray(shape.input_bytes*8),BitArray(shape.output_bytes*8))
