# Internal connection allocator. No caller-supplied private ID/entropy seed.
from Compiler.library import export
from Compiler.GC.types import sbitvec,sbit
from backend_adapter.boolean import load
from backend_adapter.aig_packed import execute_mpc
from handshake_backend import binary_io
image=load(program.args[1])
assert image['name']=='tls-private-request-id-seed' and image['input_bits']==64
assert len(image['outputs'])==64
def initialize(inputs,outputs):
    # Public connection context is an explicit argument; entropy is joint VM
    # randomness. The proved seed circuit forces prefix10/canonical width10.
    binary_io.read_bits(inputs)
    private_random=[sbit.get_random_bit() for _ in range(64)]
    binary_io.write_bits(outputs,execute_mpc(image,private_random))
initialize.__name__='tls_binary_tls_private_request_id_init'
BitArray=sbitvec.get_type(1).Array
export(initialize)(BitArray(128),BitArray(64))
