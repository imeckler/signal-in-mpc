       rk_off += 8;\n        }\n\n        sub_bytes(&mut state);\n        mix_columns_0(&mut state);\n        add_round_key(&mut state, &rkeys[rk_off..(rk_off + 8)]);\n        rk_off += 8;\n    }\n\n    #[cfg(not(aes_backend_soft = \"compact\"))]\n    {\n        shift_rows_2(&mut state);\n    }\n\n    sub_bytes(&mut state);\n    add_round_key(&mut state, &rkeys[112..]);\n\n    inv_bitslice(&state)\n}","attr_info":{"attributes":[{"DocComment":" Fully-fixsliced AES-256 encryption (the ShiftRows is completely omitted)."},{"DocComment":""},{"DocComment":" Encrypts four blocks in-place and in parallel."}],"inline":null,"rename":null,"public":false},"is_local":true,"opacity":"Transparent","lang_item":null,"diagnostic_item":null},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Free":0}},{"Untagged":{"Array":[{"Untagged":{"Literal":{"UInt":"U64"}}},{"Untagged":[{"Literal":{"Scalar":{"Unsigned":["Usize","120"]}}},{"Untagged":{"Literal":{"UInt":"Usize"}}}]}]}},"Shared"]}},{"Untagged":{"Ref":[{"Var":{"Free":1}},{"Untagged":{"Adt":{"id":{"Adt":0},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}},"Shared"]}}],"output":{"Untagged":{"Adt":{"id":{"Adt":0},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}}},"src":"Normal","body":{"Structured":{"span":{"data":{"file_id":0,"beg":{"line":536,"col":0},"end":{"line":587,"col":1}},"generated_from_span":null},"bound_body_regions":194,"locals":{"arg_count":2,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":0,"beg":{"line":536,"col":79},"end":{"line":536,"col":90}},"generated_from_span":null},"ty":{"Untagged":{"Adt":{"id":{"Adt":0},"generics":{"regio