oft",0]},{"Ident":["fixslice",0]},{"Ident":["inv_bitslice",0]},{"Ident":["write_reordered",0]}],"span":{"data":{"file_id":0,"beg":{"line":1317,"col":4},"end":{"line":1326,"col":5}},"generated_from_span":null},"source_text":"fn write_reordered(columns: u64, output: &mut [u8]) {\n        output[0x0] = (columns        ) as u8;\n        output[0x1] = (columns >> 0x10) as u8;\n        output[0x2] = (columns >> 0x20) as u8;\n        output[0x3] = (columns >> 0x30) as u8;\n        output[0x8] = (columns >> 0x08) as u8;\n        output[0x9] = (columns >> 0x18) as u8;\n        output[0xa] = (columns >> 0x28) as u8;\n        output[0xb] = (columns >> 0x38) as u8;\n    }","attr_info":{"attributes":[{"Unknown":{"path":"rustfmt::skip","args":null}}],"inline":null,"rename":null,"public":false},"is_local":true,"opacity":"Transparent","lang_item":null,"diagnostic_item":null},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Literal":{"UInt":"U64"}}},{"Untagged":{"Ref":[{"Var":{"Free":0}},{"Untagged":{"Slice":{"Untagged":{"Literal":{"UInt":"U8"}}}}},"Mut"]}}],"output":{"Untagged":{"Adt":{"id":{"Builtin":"Tuple"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}}},"src":"Normal","body":{"Structured":{"span":{"data":{"file_id":0,"beg":{"line":1317,"col":4},"end":{"line":1326,"col":5}},"generated_from_span":null},"bound_body_regions":2,"locals":{"arg_count":2,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":0,"beg":{"line":1317,"col":55},"end":{"line":1317,"col":55}},"generated_from_span":null},"ty":{"Untagged":{"Adt":{"id":{"Builtin":"Tuple"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}}},{"index":1,"name":"columns","span":{"data":{"file_id":0,"beg":{"line":1317,"col":23},"e