import ChatResponseReferenceWork.StreamingV1.ScalarSuccessNative
open Aeneas Aeneas.Std TlsMpc TlsMpc.Signal
namespace ChatResponseReference.StreamingV1
open ActualInnerResponseV1
open LibSignalReference.Candidate.ProstSkipBuf LibSignalReference.Candidate.ProstSkipSlice

/-- Actual generated Bytes field success forces actual native length success,
physical copy fit, exact replacement content and native returned suffix. -/
theorem actual_body_success_native (source next : InnerResponseV1.Message) (before after : Slice U8)
    (ctx : prost.encoding.DecodeContext)
    (observed : merge_response InnerResponseV1.sliceBuf source (4#u32) .LengthDelimited before ctx = .ok (.Ok (),next,after)) :
    ∃ native middle,
      LoopSupportSkip.encoding.varint.decode_varint sliceBuf before = .ok (.Ok native,middle) ∧ native.val ≤ middle.length ∧
      next = {source with body := some ⟨ActualResponseBytesV1.ContentModel.take middle (UScalar.cast .Usize native).val⟩} ∧
      after = LibSignalReference.Candidate.ProstBytesBuf.drop middle native.val := by
  obtain ⟨decoded,middle,run,_,_⟩ := decode_full_reference before
  rw [actual_body_field_decoded source before middle ctx decoded run] at observed
  cases decoded with
  | Err error =>
    simp only [bodyFieldDecoded,BytesContentV1.bytesResult] at observed
    have success := stamped_field_success _ _ _ _ _ _ observed
    cases success.1
  | Ok native =>
    by_cases fits : native.val ≤ middle.length
    · rw [body_field_success source middle native fits] at observed
      have same := Result.ok.inj observed
      have valueEq := congrArg (fun x => x.2.1) same
      have cursorEq := congrArg (fun x => x.2.2) same
      exact ⟨native,middle,run,fits,valueEq.symm,cursorEq.symm⟩
    · simp only [bodyFieldDecoded,BytesContentV1.bytesResult,if_neg fits] at observed
      have success := stamped_field_success _ _ _ _ _ _ observed
      cases success.1

#print axioms actual_body_success_native
end ChatResponseReference.StreamingV1
