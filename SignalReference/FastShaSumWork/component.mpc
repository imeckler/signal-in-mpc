# Public artifact lowering comparison only; no native MPC run.
program.set_security(128)
from Compiler.library import export
from Compiler.GC.types import sbitvec
from handshake_backend import binary_io
from backend_adapter.boolean import load
from backend_adapter.aig_packed import execute_mpc
image=load(program.args[1])
def sha_component(inputs,outputs):
    binary_io.write_bits(outputs,execute_mpc(image,binary_io.read_bits(inputs)))
sha_component.__name__='sha_sum_'+program.args[2]+'_'+program.args[3].replace('-','_')
function=export(sha_component);BitArray=sbitvec.get_type(1).Array
function(BitArray(image['input_bits']),BitArray(len(image['outputs'])))
