# Same-VM public-shape harness. Five-party XOR shares; all outputs remain secret.
# Fresh scalar bits come from checked joint daBits. No native/network claim.
program.unlimited_compilation()
from Compiler.GC.types import sbit
from backend_adapter.boolean import load as load_boolean
from handshake_backend.field_dag import load as load_field
from SignalReference.NewRatchetReceiveWork.adapter import receive, fresh_private_bits
field_image = load_field(program.args[1])
receive_image = load_boolean(program.args[2])
wire_bytes = int(program.args[3])

def shared_bytes(length):
    bits = []
    for _ in range(8 * length):
        bit = sbit.get_input_from(0)
        for party in range(1, 5):
            bit = bit ^ sbit.get_input_from(party)
        bits.append(bit)
    return bits

present = shared_bytes(1)
old = shared_bytes(136)
remote = shared_bytes(32)
pq = shared_bytes(32)
sender = shared_bytes(32)
receiver = shared_bytes(32)
addresses = shared_bytes(36)
wire = shared_bytes(wire_bytes)
private = fresh_private_bits()
output = receive(field_image, receive_image, present, old, private, remote,
                 pq, sender, receiver, addresses, wire)
for index, bit in enumerate(output):
    bit.store_in_mem(index)
