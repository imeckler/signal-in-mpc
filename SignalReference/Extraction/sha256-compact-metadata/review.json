            "attr_info": {
              "attributes": [
                {
                  "DocComment": " Returns the value that would be obtained by taking the *successor*"
                },
                {
                  "DocComment": " of `self` `count` times along with a boolean tracking whether overflow"
                },
                {
                  "DocComment": " occurred."
                },
                {
                  "DocComment": ""
                },
                {
                  "DocComment": " If this would overflow the range of values supported by `Self`, the"
                },
                {
                  "DocComment": " value returned is unspecified and should not be relied on, though"
                },
                {
                  "DocComment": " typically wrapping (modular arithmetic) is the most effective"
                },
                {
                  "DocComment": " implementation to enable optimizations."
                },
                {
                  "DocComment": ""
                },
                {
                  "DocComment": " # Invariants"
                },
                {
                  "DocComment": ""
                },
                {
                  "DocComment": " For any `a`, `n`, and `m`, where no overflow occurs:"
                },
                {
                  "DocComment": ""
                },
                {
                  "DocComment": " * `Step::forward_overflowing(Step::forward_overflowing(a, n).0, m) == Step::forward_overflowing(a, n + m)`"
                },
                {
                  "DocComment": ""
                },
                {
                  "DocComment": " For any `a` and `n`, where no overflow occurs:"
                },
                {
                  "DocComment": ""
                },
                {
                  "DocComment": " * `Step::forward_overflowing(a, n) == (Step::forward_checked(a, n).unwrap(), false)`"
                },
                {
                  "DocComment": ""
                },
                {
                  "DocComment": " For any `a` and `n`:"
                },
                {
                  "DocComment": ""
                },
                {
                  "DocComment": " * `Step::forward_overflowing(a, n) == (0..n).fold((a, false), |(x, y), _| { let (s, o) = Step::forward_overflowing(x, 1); (s, y || o) })`"
                },
                {
                  "DocComment": "   * Corollary: `Step::forward_overflowing(a, 0) == (a, false)`"
                }
              ],
              "inline": null,
              "rename": null,
              "public": true
            },
