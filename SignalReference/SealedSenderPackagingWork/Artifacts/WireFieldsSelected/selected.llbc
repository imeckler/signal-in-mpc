"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Untagged":{"TypeVar":{"Free":0}}},{"Untagged":{"TypeVar":{"Bound":[0,0]}}}],"const_generics":[],"trait_refs":[{"Untagged":{"kind":"SelfId","trait_decl_ref":{"regions":[],"skip_binder":{"id":3,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]}}}}},{"Untagged":{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":4,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Bound":[1,0]}}}],"const_generics":[],"trait_refs":[]}}}}}]}}},"kind":{"TraitMethod":[3,4]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"put_slice","item_meta":{"name":[{"Ident":["bytes",0]},{"Ident":["buf",0]},{"Ident":["buf_mut",0]},{"Ident":["BufMut",0]},{"Ident":["put_slice",0]}],"span":{"data":{"file_id":7,"beg":{"line":246,"col":4},"end":{"line":246,"col":43}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Transfer bytes into `self` from `src` and advance the cursor by the"},{"DocComment":" number of bytes written."},{"DocComment":""},{"DocComment":" `self` must have enough remaining capacity to contain all of `src`."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::BufMut;"},{"DocComment":""},{"DocComment":" let mut dst = [0; 6];"},{"DocComment":""},{"DocComment":" {"},{"DocComment":"     let mut buf = &mut dst[..];"},{"DocComment":"     buf.put_slice(b\"hello\");"},{"DocComment":""},{"DocComment":"     assert_eq!(1, buf.remaining_mut());"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" assert_eq!(b\"hello\\0\", &dst);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":