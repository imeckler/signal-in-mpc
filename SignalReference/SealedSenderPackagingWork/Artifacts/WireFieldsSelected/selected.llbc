const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"clear","item_meta":{"name":[{"Ident":["prost",0]},{"Ident":["message",0]},{"Ident":["Message",0]},{"Ident":["clear",0]}],"span":{"data":{"file_id":3,"beg":{"line":153,"col":4},"end":{"line":153,"col":24}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Clears the message, resetting all fields to their default."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":0}}},"Mut"]}}],"output":{"Untagged":{"Adt":{"id":{"Builtin":"Tuple"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}}},"default":null},"kind":{"TraitMethod":[0,11]}}],"vtable":{"id":{"Adt":1},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}},{"def_id":1,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["Send",0]}],"span":{"data":{"file_id":5,"beg":{"line":92,"col":0},"end":{"line":92,"col":26}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Types that can be transferred across thread boundaries."},{"DocComment":""},{"DocComment":" This trait is automatically implemented when the compiler determines it's"},{"DocComment":" appropriate."},{"DocComment":""},{"DocComment":" An example of a non-`Send` type is the reference-counting pointer"},{"DocComment":" [`rc::Rc`][`Rc`]. If two threads attempt to clone [`Rc`]s that point to the same"},{"DocComment":" reference-counted value, they might try to update the reference count at the"},{"DocComment":" same time, which is [undefined behavior][ub] because [`Rc`] doesn't use atomic"},{"DocComment":" operations. Its cousin [`sync::Arc`][arc] does use atomic operations (incurring"},{"DocComment":" some overhead) and thus is `Send`."},{"DocComment":""},{"DocComment":" See [the Nomicon](../../nomicon/send-and-sync.html) and the [`Sync`] trait for more details."},{"DocComment":""},{"DocComment":" [`Rc`]: ../../std/rc/struct.Rc.html"},{"DocComment":" [arc]: ../../std/sync/struct.Arc.html"},{"DocComment":" [ub]: ../../reference/behavior-considered-undefined.html"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"Send"},"src":"Normal","generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[],"vtable":{"id":{"Adt":10},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}},{"def_id":2,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["Sync",0]}],"span":{"data":{"file_id":5,"beg":{"line":657,"col":0},"end":{"line":657,"col":26}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Types for which it is safe to share references between threads."},{"DocComment":""},{"DocComment":" This trait is automatically implemented when the compiler determines"},{"DocComment":" it's appropriate."},{"DocComment":""},{"DocComment":" The precise definition is: a type `T` is [`Sync`] if and only if `&T` is"},{"DocComment":" [`Send`]. In other words, if there is no possibility of"},{"DocComment":" [undefined behavior][ub] (including data races) when passing"},{"DocComment":" `&T` references between threads."},{"DocComment":""},{"DocComment":" As one would expect, primitive types like [`u8`] and [`f64`]"},{"DocComment":" are all [`Sync`], and so are simple aggregate types containing them,"},{"DocComment":" like tuples, structs and enums. More examples of basic [`Sync`]"},{"DocComment":" types include \"immutable\" types like `&T`, and those with simple"},{"DocComment":" inherited mutability, such as [`Box<T>`][box], [`Vec<T>`][vec] and"},{"DocComment":" most other collection types. (Generic parameters need to be [`Sync`]"},{"DocComment":" for their container to be [`Sync`].)"},{"DocComment":""},{"DocComment":" A somewhat surprising consequence of the definition is that `&mut T`"},{"DocComment":" is `Sync` (if `T` is `Sync`) even though it seems like that might"},{"DocComment":" provide unsynchronized mutation. The trick is that a mutable"},{"DocComment":" reference behind a shared reference (that is, `& &mut T`)"},{"DocComment":" becomes read-only, as if it were a `& &T`. Hence there is no risk"},{"DocComment":" of a data race."},{"DocComment":""},{"DocComment":" A shorter overview of how [`Sync`] and [`Send`] relate to referencing:"},{"DocComment":" * `&T` is [`Send`] if and only if `T` is [`Sync`]"},{"DocComment":" * `&mut T` is [`Send`] if and only if `T` is [`Send`]"},{"DocComment":" * `&T` and `&mut T` are [`Sync`] if and only if `T` is [`Sync`]"},{"DocComment":""},{"DocComment":" Types that are not `Sync` are those that have \"interior"},{"DocComment":" mutability\" in a non-thread-safe form, such as [`Cell`][cell]"},{"DocComment":" and [`RefCell`][refcell]. These types allow for mutation of"},{"DocComment":" their contents even through an immutable, shared reference. For"},{"DocComment":" example the `set` method on [`Cell<T>`][cell] takes `&self`, so it requires"},{"DocComment":" only a shared reference [`&Cell<T>`][cell]. The method performs no"},{"DocComment":" synchronization, thus [`Cell`][cell] cannot be `Sync`."},{"DocComment":""},{"DocComment":" Another example of a non-`Sync` type is the reference-counting"},{"DocComment":" pointer [`Rc`][rc]. Given any reference [`&Rc<T>`][rc], you can clone"},{"DocComment":" a new [`Rc<T>`][rc], modifying the reference counts in a non-atomic way."},{"DocComment":""},{"DocComment":" For cases when one does need thread-safe interior mutability,"},{"DocComment":" Rust provides [atomic data types], as well as explicit locking via"},{"DocComment":" [`sync::Mutex`][mutex] and [`sync::RwLock`][rwlock]. These types"},{"DocComment":" ensure that any mutation cannot cause data races, hence the types"},{"DocComment":" are `Sync`. Likewise, [`sync::Arc`][arc] provides a thread-safe"},{"DocComment":" analogue of [`Rc`][rc]."},{"DocComment":""},{"DocComment":" Any types with interior mutability must also use the"},{"DocComment":" [`cell::UnsafeCell`][unsafecell] wrapper around the value(s) which"},{"DocComment":" can be mutated through a shared reference. Failing to doing this is"},{"DocComment":" [undefined behavior][ub]. For example, [`transmute`][transmute]-ing"},{"DocComment":" from `&T` to `&mut T` is invalid."},{"DocComment":""},{"DocComment":" See [the Nomicon][nomicon-send-and-sync] for more details about `Sync`."},{"DocComment":""},{"DocComment":" [box]: ../../std/boxed/struct.Box.html"},{"DocComment":" [vec]: ../../std/vec/struct.Vec.html"},{"DocComment":" [cell]: crate::cell::Cell"},{"DocComment":" [refcell]: crate::cell::RefCell"},{"DocComment":" [rc]: ../../std/rc/struct.Rc.html"},{"DocComment":" [arc]: ../../std/sync/struct.Arc.html"},{"DocComment":" [atomic data types]: crate::sync::atomic"},{"DocComment":" [mutex]: ../../std/sync/struct.Mutex.html"},{"DocComment":" [rwlock]: ../../std/sync/struct.RwLock.html"},{"DocComment":" [unsafecell]: crate::cell::UnsafeCell"},{"DocComment":" [ub]: ../../reference/behavior-considered-undefined.html"},{"DocComment":" [transmute]: crate::mem::transmute"},{"DocComment":" [nomicon-send-and-sync]: ../../nomicon/send-and-sync.html"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"Sync","diagnostic_item":"Sync"},"src":"Normal","generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[],"vtable":{"id":{"Adt":11},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}},{"def_id":3,"item_meta":{"name":[{"Ident":["bytes",0]},{"Ident":["buf",0]},{"Ident":["buf_mut",0]},{"Ident":["BufMut",0]}],"span":{"data":{"file_id":7,"beg":{"line":30,"col":0},"end":{"line":30,"col":23}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A trait for values that provide sequential write access to bytes."},{"DocComment":""},{"DocComment":" Write bytes to a buffer"},{"DocComment":""},{"DocComment":" A buffer stores bytes in memory such that write operations are infallible."},{"DocComment":" The underlying storage may or may not be in contiguous memory. A `BufMut`"},{"DocComment":" value is a cursor into the buffer. Writing to `BufMut` advances the cursor"},{"DocComment":" position."},{"DocComment":""},{"DocComment":" The simplest `BufMut` is a `Vec<u8>`."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::BufMut;"},{"DocComment":""},{"DocComment":" let mut buf = vec![];"},{"DocComment":""},{"DocComment":" buf.put(&b\"hello world\"[..]);"},{"DocComment":""},{"DocComment":" assert_eq!(buf, b\"hello world\");"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"src":"Normal","generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"remaining_mut","item_meta":{"name":[{"Ident":["bytes",0]},{"Ident":["buf",0]},{"Ident":["buf_mut",0]},{"Ident":["BufMut",0]},{"Ident":["remaining_mut",0]}],"span":{"data":{"file_id":7,"beg":{"line":64,"col":4},"end":{"line":64,"col":37}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns the number of bytes that can be written from the current"},{"DocComment":" position until the end of the buffer is reached."},{"DocComment":""},{"DocComment":" This value is greater than or equal to the length of the slice returned"},{"DocComment":" by `chunk_mut()`."},{"DocComment":""},{"DocComment":" Writing to a `BufMut` may involve allocating more memory on the fly."},{"DocComment":" Implementations may fail before reaching the number of bytes indicated"},{"DocComment":" by this method if they encounter an allocation failure."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::BufMut;"},{"DocComment":""},{"DocComment":" let mut dst = [0; 10];"},{"DocComment":" let mut buf = &mut dst[..];"},{"DocComment":""},{"DocComment":" let original_remaining = buf.remaining_mut();"},{"DocComment":" buf.put(&b\"hello\"[..]);"},{"DocComment":""},{"DocComment":" assert_eq!(original_remaining - 5, buf.remaining_mut());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Implementer notes"},{"DocComment":""},{"DocComment":" Implementations of `remaining_mut` should ensure that the return value"},{"DocComment":" does not change unless a call is made to `advance_mut` or any other"},{"DocComment":" function that is documented to change the `BufMut`'s current position."},{"DocComment":""},{"DocComment":" # Note"},{"DocComment":""},{"DocComment":" `remaining_mut` may return value smaller than actual available space."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":0}}},"Shared"]}}],"output":{"Untagged":{"Literal":{"UInt":"Usize"}}}},"default":null},"kind":{"TraitMethod":[3,0]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"advance_mut","item_meta":{"name":[{"Ident":["bytes",0]},{"Ident":["buf",0]},{"Ident":["buf_mut",0]},{"Ident":["BufMut",0]},{"Ident":["advance_mut",0]}],"span":{"data":{"file_id":7,"beg":{"line":107,"col":4},"end":{"line":107,"col":49}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Advance the internal cursor of the BufMut"},{"DocComment":""},{"DocComment":" The next call to `chunk_mut` will return a slice starting `cnt` bytes"},{"DocComment":" further into the underlying buffer."},{"DocComment":""},{"DocComment":" # Safety"},{"DocComment":""},{"DocComment":" The caller must ensure that the next `cnt` bytes of `chunk` are"},{"DocComment":" initialized."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::BufMut;"},{"DocComment":""},{"DocComment":" let mut buf = Vec::with_capacity(16);"},{"DocComment":""},{"DocComment":" // Write some data"},{"DocComment":" buf.chunk_mut()[0..2].copy_from_slice(b\"he\");"},{"DocComment":" unsafe { buf.advance_mut(2) };"},{"DocComment":""},{"DocComment":" // write more bytes"},{"DocComment":" buf.chunk_mut()[0..3].copy_from_slice(b\"llo\");"},{"DocComment":""},{"DocComment":" unsafe { buf.advance_mut(3); }"},{"DocComment":""},{"DocComment":" assert_eq!(5, buf.len());"},{"DocComment":" assert_eq!(buf, b\"hello\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" This function **may** panic if `cnt > self.remaining_mut()`."},{"DocComment":""},{"DocComment":" # Implementer notes"},{"DocComment":""},{"DocComment":" It is recommended for implementations of `advance_mut` to panic if"},{"DocComment":" `cnt > self.remaining_mut()`. If the implementation does not panic,"},{"DocComment":" the call must behave as if `cnt == self.remaining_mut()`."},{"DocComment":""},{"DocComment":" A call with `cnt == 0` should never panic and be a no-op."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":0}}},"Mut"]}},{"Untagged":{"Literal":{"UInt":"Usize"}}}],"output":{"Untagged":{"Adt":{"id":{"Builtin":"Tuple"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}}},"default":null},"kind":{"TraitMethod":[3,1]}},null,{"params":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"chunk_mut","item_meta":{"name":[{"Ident":["bytes",0]},{"Ident":["buf",0]},{"Ident":["buf_mut",0]},{"Ident":["BufMut",0]},{"Ident":["chunk_mut",0]}],"span":{"data":{"file_id":7,"beg":{"line":179,"col":4},"end":{"line":179,"col":48}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns a mutable slice starting at the current BufMut position and of"},{"DocComment":" length between 0 and `BufMut::remaining_mut()`. Note that this *can* be shorter than the"},{"DocComment":" whole remainder of the buffer (this allows non-continuous implementation)."},{"DocComment":""},{"DocComment":" This is a lower level function. Most operations are done with other"},{"DocComment":" functions."},{"DocComment":""},{"DocComment":" The returned byte slice may represent uninitialized memory."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::BufMut;"},{"DocComment":""},{"DocComment":" let mut buf = Vec::with_capacity(16);"},{"DocComment":""},{"DocComment":" unsafe {"},{"DocComment":"     // MaybeUninit::as_mut_ptr"},{"DocComment":"     buf.chunk_mut()[0..].as_mut_ptr().write(b'h');"},{"DocComment":"     buf.chunk_mut()[1..].as_mut_ptr().write(b'e');"},{"DocComment":""},{"DocComment":"     buf.advance_mut(2);"},{"DocComment":""},{"DocComment":"     buf.chunk_mut()[0..].as_mut_ptr().write(b'l');"},{"DocComment":"     buf.chunk_mut()[1..].as_mut_ptr().write(b'l');"},{"DocComment":"     buf.chunk_mut()[2..].as_mut_ptr().write(b'o');"},{"DocComment":""},{"DocComment":"     buf.advance_mut(3);"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" assert_eq!(5, buf.len());"},{"DocComment":" assert_eq!(buf, b\"hello\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Implementer notes"},{"DocComment":""},{"DocComment":" This function should never panic. `chunk_mut()` should return an empty"},{"DocComment":" slice **if and only if** `remaining_mut()` returns 0. In other words,"},{"DocComment":" `chunk_mut()` returning an empty slice implies that `remaining_mut()` will"},{"DocComment":" return 0 and `remaining_mut()` returning 0 implies that `chunk_mut()` will"},{"DocComment":" return an empty slice."},{"DocComment":""},{"DocComment":" This function may trigger an out-of-memory abort if it tries to allocate"},{"DocComment":" memory and fails to do so."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":0}}},"Mut"]}}],"output":{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"Adt":{"id":{"Adt":13},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}},"Mut"]}}},"default":null},"kind":{"TraitMethod":[3,3]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutabil