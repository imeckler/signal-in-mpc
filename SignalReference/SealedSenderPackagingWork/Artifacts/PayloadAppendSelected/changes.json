          "attr_info": {
            "attributes": [
              {
                "DocComment": " Advance the internal cursor of the BufMut"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " The next call to `chunk_mut` will return a slice starting `cnt` bytes"
              },
              {
                "DocComment": " further into the underlying buffer."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " # Safety"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " The caller must ensure that the next `cnt` bytes of `chunk` are"
              },
              {
                "DocComment": " initialized."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " # Examples"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " ```"
              },
              {
                "DocComment": " use bytes::BufMut;"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " let mut buf = Vec::with_capacity(16);"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " // Write some data"
              },
              {
                "DocComment": " buf.chunk_mut()[0..2].copy_from_slice(b\"he\");"
              },
              {
                "DocComment": " unsafe { buf.advance_mut(2) };"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " // write more bytes"
              },
              {
                "DocComment": " buf.chunk_mut()[0..3].copy_from_slice(b\"llo\");"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " unsafe { buf.advance_mut(3); }"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " assert_eq!(5, buf.len());"
              },
              {
                "DocComment": " assert_eq!(buf, b\"hello\");"
              },
              {
                "DocComment": " ```"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " # Panics"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " This function **may** panic if `cnt > self.remaining_mut()`."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " # Implementer notes"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " It is recommended for implementations of `advance_mut` to panic if"
              },
              {
                "DocComment": " `cnt > self.remaining_mut()`. If the implementation does not panic,"
              },
              {
                "DocComment": " the call must behave as if `cnt == self.remaining_mut()`."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " A call with `cnt == 0` should never panic and be a no-op."
              }
            ],
