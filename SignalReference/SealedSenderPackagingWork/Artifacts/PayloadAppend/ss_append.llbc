y_get_` methods of [`Buf`]."},{"DocComment":" Indicates that there were not enough remaining"},{"DocComment":" bytes in the buffer while attempting"},{"DocComment":" to get a value from a [`Buf`] with one"},{"DocComment":" of the `try_get_` methods."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":{"Struct":[{"span":{"data":{"file_id":9,"beg":{"line":177,"col":4},"end":{"line":177,"col":24}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" The number of bytes necessary to get the value"}],"inline":null,"rename":null,"public":true},"name":"requested","is_positional":false,"ty":{"Untagged":{"Literal":{"UInt":"Usize"}}}},{"span":{"data":{"file_id":9,"beg":{"line":180,"col":4},"end":{"line":180,"col":24}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" The number of bytes available in the buffer"}],"inline":null,"rename":null,"public":true},"name":"available","is_positional":false,"ty":{"Untagged":{"Literal":{"UInt":"Usize"}}}}]},"layout":[{"key":"aarch64-apple-darwin","value":{"size":{"guarantee":null,"chosen":16},"align":{"guarantee":null,"chosen":8},"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[{"guarantee":null,"chosen":0},{"guarantee":null,"chosen":8}],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None"},{"def_id":6,"item_meta":{"name":[{"Ident":["bytes",0]},{"Ident":["bytes",0]},{"Ident":["Bytes",0]}],"span":{"data":{"file_id":14,"beg":{"line":101,"col":0},"end":{"line":101,"col":16}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A cheaply cloneable and sliceable chunk of contiguous memory."},{"DocComment":""},{"DocComment":" `Bytes` is an efficient container for storing and operating on contiguous"},{"DocComment":" slices of memory. It is intended for use primarily in networking code, but"},{"DocComment":" could have applications elsewhere as well."},{"DocComment":""},{"DocComment":" `Bytes` values facilitate zero-copy network programming by allowing multiple"},{"DocComment":" `Bytes` objects to point to the same underlying memory."},{"DocComment":""},{"DocComment":" `Bytes` does not have a single implementation. It is an interface, whose"},{"DocComment":" exact behavior is implemented through dynamic dispatch in several underlying"},{"DocComment":" implementations of `Bytes`."},{"DocComment":""},{"DocComment":" All `Bytes` implementations must fulfill the following requirements:"},{"DocComment":" - They are cheaply cloneable and thereby shareable between an unlimited amount"},{"DocComment":"   of components, for example by modifying a reference count."},{"DocComment":" - Instances can be sliced to refer to a subset of the original buffer."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::Bytes;"},{"DocComment":""},{"DocComment":" let mut mem = Bytes::from(\"Hello world\");"},{"DocComment":" let a = mem.slice(0..5);"},{"DocComment":""},{"DocComment":" assert_eq!(a, \"Hello\");"},{"DocComment":""},{"DocComment":" let b = mem.split_to(6);"},{"DocComment":""},{"DocComment":" assert_eq!(mem, \"world\");"},{"DocComment":" assert_eq!(b, \"Hello \");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Memory layout"},{"DocComment":""},{"DocComment":" The `Bytes` struct itself is fairly small, limited to 4 `usize` fields used"},{"DocComment":" to track information about which segment of the underlying memory the"},{"DocComment":" `Bytes` handle has access to."},{"DocComment":""},{"DocComment":" `Bytes` keeps both a pointer to the shared state containing the full memory"},{"DocComment":" slice and a pointer to the start of the region visible by the handle."},{"DocComment":" `Bytes` also tracks the length of its view into the memory."},{"DocComment":""},{"DocComment":" # Sharing"},{"DocComment":""},{"DocComment":" `Bytes` contains a vtable, which allows implementations of `Bytes` to define"},{"DocComment":" how sharing/cloning is implemented in detail."},{"DocComment":" When `Bytes::clone()` is called, `Bytes` will call the vtable function for"},{"DocComment":" cloning the backing storage in order to share it behind multiple `Bytes`"},{"DocComment":" instances."},{"DocComment":""},{"DocComment":" For `Bytes` implementations which refer to constant memory (e.g. created"},{"DocComment":" via `Bytes::from_static()`) the cloning implementation will be a no-op."},{"DocComment":""},{"DocComment":" For `Bytes` implementations which point to a reference counted shared storage"},{"DocComment":" (e.g. an `Arc<[u8]>`), sharing will be implemented by increasing the"},{"DocComment":" reference count."},{"DocComment":""},{"DocComment":" Due to this mechanism, multiple `Bytes` instances may point to the same"},{"DocComment":" shared memory region."},{"DocComment":" Each `Bytes` instance can point to different sections within that"},{"DocComment":" memory region, and `Bytes` instances may or may not have overlapping views"},{"DocComment":" into the memory."},{"DocComment":""},{"DocComment":" The following diagram visualizes a scenario where 2 `Bytes` instances make"},{"DocComment":" use of an `Arc`-based backing storage, and provide access to different views:"},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":""},{"DocComment":"    Arc ptrs                   ┌─────────┐"},{"DocComment":"    ________________________ / │ Bytes 2 │"},{"DocComment":"   /                           └─────────┘"},{"DocComment":"  /          ┌───────────┐     |         |"},{"DocComment":" |_________/ │  Bytes 1  │     |         |"},{"DocComment":" |           └───────────┘     |         |"},{"DocComment":" |           |           | ___/ data     | tail"},{"DocComment":" |      data |      tail |/              |"},{"DocComment":" v           v           v               v"},{"DocComment":" ┌─────┬─────┬───────────┬───────────────┬─────┐"},{"DocComment":" │ Arc │     │           │               │     │"},{"DocComment":" └─────┴─────┴───────────┴───────────────┴─────┘"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[{"key":"aarch64-apple-darwin","value":{"size":{"guarantee":null,"chosen":32},"align":{"guarantee":null,"chosen":8},"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[{"guarantee":null,"chosen":8},{"guarantee":null,"chosen":16},{"guarantee":null,"chosen":24},{"guarantee":null,"chosen":0}],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None"},{"def_id":7,"item_meta":{"name":[{"Ident":["bytes",0]},{"Ident":["buf",0]},{"Ident":["take",0]},{"Ident":["Take",0]}],"span":{"data":{"file_id":15,"beg":{"line":13,"col":0},"end":{"line":13,"col":18}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A `Buf` adapter which limits the bytes read from an underlying buffer."},{"DocComment":""},{"DocComment":" This struct is generally created by calling `take()` on `Buf`. See"},{"DocComment":" documentation of [`take()`](Buf::take) for more details."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[],"ptr_metadata":"None"},{"def_id":8,"item_meta":{"name":[{"Ident":["bytes",0]},{"Ident":["buf",0]},{"Ident":["chain",0]},{"Ident":["Chain",0]}],"span":{"data":{"file_id":16,"beg":{"line":30,"col":0},"end":{"line":30,"col":22}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A `Chain` sequences two buffers."},{"DocComment":""},{"DocComment":" `Chain` is an adapter that links two underlying buffers and provides a"},{"DocComment":" continuous view across both buffers. It is able to sequence either immutable"},{"DocComment":" buffers ([`Buf`] values) or mutable buffers ([`BufMut`] values)."},{"DocComment":""},{"DocComment":" This struct is generally created by calling [`Buf::chain`]. Please see that"},{"DocComment":" function's documentation for more detail."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::{Bytes, Buf};"},{"DocComment":""},{"DocComment":" let mut buf = (&b\"hello \"[..])"},{"DocComment":"     .chain(&b\"world\"[..]);"},{"DocComment":""},{"DocComment":" let full: Bytes = buf.copy_to_bytes(11);"},{"DocComment":" assert_eq!(full[..], b\"hello world\"[..]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`Buf::chain`]: Buf::chain"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Covariant"},{"index":1,"name":"U","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[],"ptr_metadata":"None"},{"def_id":9,"item_meta":{"name":[{"Ident":["bytes",0]},{"Ident":["buf",0]},{"Ident":["reader",0]},{"Ident":["Reader",0]}],"span":{"data":{"file_id":17,"beg":{"line":11,"col":0},"end":{"line":11,"col":20}},"generated_from_span":null},"source_text":null,"attr_info