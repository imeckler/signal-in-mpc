""},{"DocComment":" Now, you get all of the default values. Rust implements `Default` for various primitive types."},{"DocComment":""},{"DocComment":" If you want to override a particular option, but still retain the other defaults:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #[allow(dead_code)]"},{"DocComment":" # #[derive(Default)]"},{"DocComment":" # struct SomeOptions {"},{"DocComment":" #     foo: i32,"},{"DocComment":" #     bar: f32,"},{"DocComment":" # }"},{"DocComment":" fn main() {"},{"DocComment":"     let options = SomeOptions { foo: 42, ..Default::default() };"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## Derivable"},{"DocComment":""},{"DocComment":" This trait can be used with `#[derive]` if all of the type's fields implement"},{"DocComment":" `Default`. When `derive`d, it will use the default value for each field's type."},{"DocComment":""},{"DocComment":" ### `enum`s"},{"DocComment":""},{"DocComment":" When using `#[derive(Default)]` on an `enum`, you need to choose which unit variant will be"},{"DocComment":" default. You do this by placing the `#[default]` attribute on the variant."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #[derive(Default)]"},{"DocComment":" enum Kind {"},{"DocComment":"     #[default]"},{"DocComment":"     A,"},{"DocComment":"     B,"},{"DocComment":"     C,"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" You cannot use the `#[default]` attribute on non-unit or non-exhaustive variants."},{"DocComment":""},{"DocComment":" The `#[default]` attribute was stabilized in Rust 1.62.0."},{"DocComment":""},{"DocComment":" ## How can I implement `Default`?"},{"DocComment":""},{"DocComment":" Provide an implementation for the `default()` method that returns the value of"},{"DocComment":" your type that should be the default:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #![allow(dead_code)]"},{"DocComment":" enum Kind {"},{"DocComment":"     A,"},{"DocComment":"     B,"},{"DocComment":"     C,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl Default for Kind {"},{"DocComment":"     fn default() -> Self { Kind::A }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #[allow(dead_code)]"},{"DocComment":" #[derive(Default)]"},{"DocComment":" struct SomeOptions {"},{"DocComment":"     foo: i32,"},{"DocComment":"     bar: f32,"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"Default"},"src":"Normal","generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"default","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["default",0]},{"Ident":["Default",0]},{"Ident":["default",0]}],"span":{"data":{"file_id":5,"beg":{"line":139,"col":4},"end":{"line":139,"col":25}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns the \"default value\" for a type."},{"DocComment":""},{"DocComment":" Default values are often some kind of initial value, identity value, or anything else that"},{"DocComment":" may make sense as a default."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Using built-in default values:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let i: i8 = Default::default();"},{"DocComment":" let (x, y): (Option<String>, f64) = Default::default();"},{"DocComment":" let (a, b, (c, d)): (i32, u32, (bool, bool)) = Default::default();"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Making your own:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #[allow(dead_code)]"},{"DocComment":" enum Kind {"},{"DocComment":"     A,"},{"DocComment":"     B,"},{"DocComment":"     C,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl Default for Kind {"},{"DocComment":"     fn default() -> Self { Kind::A }"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"default_fn"},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[],"output":{"Untagged":{"TypeVar":{"Free":0}}}},"default":null},"kind":{"TraitMethod":[1,0]}}],"vtable":null},{"def_id":2,"item_meta":{"name":[{"Ident":["bytes",0]},{"Ident":["buf",0]},{"Ident":["buf_impl",0]},{"Ident":["Buf",0]}],"span":{"data":{"file_id":7,"beg":{"line":122,"col":0},"end":{"line":122,"col":13}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Read bytes from a buffer."},{"DocComment":""},{"DocComment":" A buffer stores bytes in memory such that read operations are infallible."},{"DocComment":" The underlying storage may or may not be in contiguous memory. A `Buf` value"},{"DocComment":" is a cursor into the buffer. Reading from `Buf` advances the cursor"},{"DocComment":" position. It can be thought of as an efficient `Iterator` for collections of"},{"DocComment":" bytes."},{"DocComment":""},{"DocComment":" The simplest `Buf` is a `&[u8]`."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::Buf;"},{"DocComment":""},{"DocComment":" let mut buf = &b\"hello world\"[..];"},{"DocComment":""},{"DocComment":" assert_eq!(b'h', buf.get_u8());"},{"DocComment":" assert_eq!(b'e', buf.get_u8());"},{"DocComment":" assert_eq!(b'l', buf.get_u8());"},{"DocComment":""},{"DocComment":" let mut rest = [0; 8];"},{"DocComment":" buf.copy_to_slice(&mut rest);"},{"DocComment":""},{"DocComment":" assert_eq!(&rest[..], &b\"lo world\"[..]);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"src":"Normal","generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"remaining","item_meta":{"name":[{"Ident":["bytes",0]},{"Ident":["buf",0]},{"Ident":["buf_impl",0]},{"Ident":["Buf",0]},{"Ident":["remaining",0]}],"span":{"data":{"file_id":7,"beg":{"line":148,"col":4},"end":{"line":148,"col":33}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns the number of bytes between the current position and the end of"},{"DocComment":" the buffer."},{"DocComment":""},{"DocComment":" This value is greater than or equal to the length of the slice returned"},{"DocComment":" by `chunk()`."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::Buf;"},{"DocComment":""},{"DocComment":" let mut buf = &b\"hello world\"[..];"},{"DocComment":""},{"DocComment":" assert_eq!(buf.remaining(), 11);"},{"DocComment":""},{"DocComment":" buf.get_u8();"},{"DocComment":""},{"DocComment":" assert_eq!(buf.remaining(), 10);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Implementer notes"},{"DocComment":""},{"DocComment":" Implementations of `remaining` should ensure that the return value does"},{"DocComment":" not change unless a call is made to `advance` or any other function that"},{"DocComment":" is documented to change the `Buf`'s current position."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":0}}},"Shared"]}}],"output":{"Untagged":{"Literal":{"UInt":"Usize"}}}},"default":null},"kind":{"TraitMethod":[2,0]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"chunk","item_meta":{"name":[{"Ident":["bytes",0]},{"Ident":["buf",0]},{"Ident":["buf_impl",0]},{"Ident":["Buf",0]},{"Ident":["chunk",0]}],"span":{"data":{"file_id":7,"beg":{"line":181,"col":4},"end":{"line":181,"col":29}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns a slice starting at the current position and of length between 0"},{"DocComment":" and `Buf::remaining()`. Note that this *can* return a shorter slice (this"},{"DocComment":" allows non-continuous internal representation)."},{"DocComment":""},{"DocComment":" This is a lower level function. Most operations are done with other"},{"DocComment":" functions."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::Buf;"},{"DocComment":""},{"DocComment":" let mut buf = &b\"hello world\"[..];"},{"DocComment":""},{"DocComment":" assert_eq!(buf.chunk(), &b\"hello world\"[..]);"},{"DocComment":""},{"DocComment":" buf.advance(6);"},{"DocComment":""},{"DocComment":" assert_eq!(buf.chunk(), &b\"world\"[..]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Implementer notes"},{"DocComment":""},{"DocComment":" This function should never panic. `chunk()` should return an empty"},{"DocComment":" slice **if and only if** `remaining()` returns 0. In other words,"},{"DocComment":" `chunk()` returning an empty slice implies that `remaining()` will"},{"DocComment":" return 0 and `remaining()` returning 0 implies that `chunk()` will"},{"DocComment":" return an empty slice."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":0}}},"Shared"]}}],"output":{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"Slice":{"Untagged":{"Literal":{"UInt":"U8"}}}}},"Shared"]}}},"default":null},"kind":{"TraitMethod":[2,1]}},null,{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"advance","item_meta":{"name":[{"Ident":["bytes",0]},{"Ident":["buf",0]},{"Ident":["buf_impl",0]},{"Ident":["Buf",0]},{"Ident":["advance",0]}],"span":{"data":{"file_id":7,"beg":{"line":255,"col":4},"end":{"line":255,"col":38}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Advance the internal cursor of the Buf"},{"DocComment":""},{"DocComment":" The next call to `chunk()` will return a slice starting `cnt` bytes"},{"DocComment":" further into the underlying buffer."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::Buf;"},{"DocComment":""},{"DocComment":" let mut buf = &b\"hello world\"[..];"},{"DocComment":""},{"DocComment":" assert_eq!(buf.chunk(), &b\"hello world\"[..]);"},{"DocComment":""},{"DocComment":" buf.advance(6);"},{"DocComment":""},{"DocComment":" assert_eq!(buf.chunk(), &b\"world\"[..]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" This function **may** panic if `cnt > self.remaining()`."},{"DocComment":""},{"DocComment":" # Implementer notes"},{"DocComment":""},{"DocComment":" It is recommended for implementations of `advance` to panic if `cnt >"},{"DocComment":" self.remaining()`. If the implementation does not panic, the call must"},{"DocComment":" behave as if `cnt == self.remaining()`."},{"DocComment":""},{"DocComment":" A call with `cnt == 0` should never panic and be a no-op."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":0}}},"Mut"]}},{"Untagged":{"Literal":{"UInt":"Usize"}}}],"output":{"Untagged":{"Adt":{"id":{"Builtin":"Tuple"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}}},"default":null},"kind":{"TraitMethod":[2,3]}},null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],"vtable":{"id":{"Adt":2},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}},{"def_id":3,"item_meta":{"name":[{"Ident":["bytes",0]},{"Ident":["buf",0]},{"Ident":["buf_mut",0]},{"Ident":["BufMut",0]}],"span":{"data":{"file_id":10,"beg":{"line":30,"col":0},"end":{"line":30,"col":23}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A trait for values that provide sequential write access to bytes."},{"DocComment":""},{"DocComment":" Write bytes to a buffer"},{"DocComment":""},{"DocComment":" A buffer stores bytes in memory such that write operations are infallible."},{"DocComment":" The underlying storage may or may not be in contiguous memory. A `BufMut`"},{"DocComment":" value is a cursor into the buffer. Writing to `BufMut` advances the cursor"},{"DocComment":" position."},{"DocComment":""},{"DocComment":" The simplest `BufMut` is a `Vec<u8>`."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::BufMut;"},{"DocComment":""},{"DocComment":" let mut buf = vec![];"},{"DocComment":""},{"DocComment":" buf.put(&b\"hello world\"[..]);"},{"DocComment":""},{"DocComment":" assert_eq!(buf, b\"hello world\");"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"src":"Normal","generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"remaining_mut","item_meta":{"name":[{"Ident":["bytes",0]},{"Ident":["buf",0]},{"Ident":["buf_mut",0]},{"Ident":["BufMut",0]},{"Ident":["remaining_mut",0]}],"span":{"data":{"file_id":10,"beg":{"line":64,"col":4},"end":{"line":64,"col":37}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns the number of bytes that can be written from the current"},{"DocComment":" position until the end of the buffer is reached."},{"DocComment":""},{"DocComment":" This value is greater than or equal to the length of the slice returned"},{"DocComment":" by `chunk_mut()`."},{"DocComment":""},{"DocComment":" Writing to a `BufMut` may involve allocating more memory on the fly."},{"DocComment":" Implementations may fail before reaching the number of bytes indicated"},{"DocComment":" by this method if they encounter an allocation failure."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::BufMut;"},{"DocComment":""},{"DocComment":" let mut dst = [0; 10];"},{"DocComment":" let mut buf = &mut dst[..];"},{"DocComment":""},{"DocComment":" let original_remaining = buf.remaining_mut();"},{"DocComment":" buf.put(&b\"hello\"[..]);"},{"DocComment":""},{"DocComment":" assert_eq!(original_remaining - 5, buf.remaining_mut());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Implementer notes"},{"DocComment":""},{"DocComment":" Implementations of `remaining_mut` should ensure that the return value"},{"DocComment":" does not change unless a call is made to `advance_mut` or any other"},{"DocComment":" function that is documented to change the `BufMut`'s current position."},{"DocComment":""},{"DocComment":" # Note"},{"DocComment":""},{"DocComment":" `remaining_mut` may return value smaller than actual available space."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":0}}},"Shared"]}}],"output":{"Untagged":{"Literal":{"UInt":"Usize"}}}},"default":null},"kind":{"TraitMethod":[3,0]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"advance_mut","item_meta":{"name":[{"Ident":["bytes",0]},{"Ident":["buf",0]},{"Ident":["buf_mut",0]},{"Ident":["BufMut",0]},{"Ident":["advance_mut",0]}],"span":{"data":{"file_id":10,"beg":{"line":107,"col":4},"end":{"line":107,"col":49}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Advance the internal cursor of the BufMut"},{"DocComment":""},{"DocComment":" The next call to `chunk_mut` will return a slice starting `cnt` bytes"},{"DocComment":" further into the underlying buffer."},{"DocComment":""},{"DocComment":" # Safety"},{"DocComment":""},{"DocComment":" The caller must ensure that the next `cnt` bytes of `chunk` are"},{"DocComment":" initialized."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::BufMut;"},{"DocComment":""},{"DocComment":" let mut buf = Vec::with_capacity(16);"},{"DocComment":""},{"DocComment":" // Write some data"},{"DocComment":" buf.chunk_mut()[0..2].copy_from_slice(b\"he\");"},{"DocComment":" unsafe { buf.advance_mut(2) };"},{"DocComment":""},{"DocComment":" // write more bytes"},{"DocComment":" buf.chunk_mut()[0..3].copy_from_slice(b\"llo\");"},{"DocComment":""},{"DocComment":" unsafe { buf.advance_mut(3); }"},{"DocComment":""},{"DocComment":" assert_eq!(5, buf.len());"},{"DocComment":" assert_eq!(buf, b\"hello\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" This function **may** panic if `cnt > self.remaining_mut()`."},{"DocComment":""},{"DocComment":" # Implementer notes"},{"DocComment":""},{"DocComment":" It is recommended for implementations of `advance_mut` to panic if"},{"DocComment":" `cnt > self.remaining_mut()`. If the implementation does not panic,"},{"DocComment":" the call must behave as if `cnt == self.remaining_mut()`."},{"DocComment":""},{"DocComment":" A call with `cnt == 0` should never panic and be a no-op."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Free":0}}},"Mut"]}},{"Untagged":{"Literal":{"UInt":"Usize"}}}],"output":{"Untagged":{"Adt":{"id":{"Builtin":"Tuple"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}}},"default":null},"kind":{"