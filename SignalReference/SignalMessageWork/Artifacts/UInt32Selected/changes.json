          "attr_info": {
            "attributes": [
              {
                "DocComment": " Returns a mutable slice starting at the current BufMut position and of"
              },
              {
                "DocComment": " length between 0 and `BufMut::remaining_mut()`. Note that this *can* be shorter than the"
              },
              {
                "DocComment": " whole remainder of the buffer (this allows non-continuous implementation)."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " This is a lower level function. Most operations are done with other"
              },
              {
                "DocComment": " functions."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " The returned byte slice may represent uninitialized memory."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " # Examples"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " ```"
              },
              {
                "DocComment": " use bytes::BufMut;"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " let mut buf = Vec::with_capacity(16);"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " unsafe {"
              },
              {
                "DocComment": "     // MaybeUninit::as_mut_ptr"
              },
              {
                "DocComment": "     buf.chunk_mut()[0..].as_mut_ptr().write(b'h');"
              },
              {
                "DocComment": "     buf.chunk_mut()[1..].as_mut_ptr().write(b'e');"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": "     buf.advance_mut(2);"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": "     buf.chunk_mut()[0..].as_mut_ptr().write(b'l');"
              },
              {
                "DocComment": "     buf.chunk_mut()[1..].as_mut_ptr().write(b'l');"
              },
              {
                "DocComment": "     buf.chunk_mut()[2..].as_mut_ptr().write(b'o');"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": "     buf.advance_mut(3);"
              },
              {
                "DocComment": " }"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " assert_eq!(5, buf.len());"
              },
              {
                "DocComment": " assert_eq!(buf, b\"hello\");"
              },
              {
                "DocComment": " ```"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " # Implementer notes"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " This function should never panic. `chunk_mut()` should return an empty"
              },
              {
                "DocComment": " slice **if and only if** `remaining_mut()` returns 0. In other words,"
              },
              {
                "DocComment": " `chunk_mut()` returning an empty slice implies that `remaining_mut()` will"
              },
              {
                "DocComment": " return 0 and `remaining_mut()` returning 0 implies that `chunk_mut()` will"
              },
              {
                "DocComment": " return an empty slice."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " This function may trigger an out-of-memory abort if it tries to allocate"
              },
              {
                "DocComment": " memory and fails to do so."
              }
            ],
