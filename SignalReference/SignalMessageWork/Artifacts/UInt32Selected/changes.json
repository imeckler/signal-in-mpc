            "attributes": [
              {
                "DocComment": " Returns the number of bytes that can be written from the current"
              },
              {
                "DocComment": " position until the end of the buffer is reached."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " This value is greater than or equal to the length of the slice returned"
              },
              {
                "DocComment": " by `chunk_mut()`."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " Writing to a `BufMut` may involve allocating more memory on the fly."
              },
              {
                "DocComment": " Implementations may fail before reaching the number of bytes indicated"
              },
              {
                "DocComment": " by this method if they encounter an allocation failure."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " # Examples"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " ```"
              },
              {
                "DocComment": " use bytes::BufMut;"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " let mut dst = [0; 10];"
              },
              {
                "DocComment": " let mut buf = &mut dst[..];"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " let original_remaining = buf.remaining_mut();"
              },
              {
                "DocComment": " buf.put(&b\"hello\"[..]);"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " assert_eq!(original_remaining - 5, buf.remaining_mut());"
              },
              {
                "DocComment": " ```"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " # Implementer notes"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " Implementations of `remaining_mut` should ensure that the return value"
              },
              {
                "DocComment": " does not change unless a call is made to `advance_mut` or any other"
              },
              {
                "DocComment": " function that is documented to change the `BufMut`'s current position."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " # Note"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " `remaining_mut` may return value smaller than actual available space."
              }
            ],
