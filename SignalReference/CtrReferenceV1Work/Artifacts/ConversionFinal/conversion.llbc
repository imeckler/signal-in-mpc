presentation of nonce.\n    type CtrNonce: Clone;\n    /// Backend numeric type\n    type Backend: StreamCipherCounter;\n    /// Flavor name\n    const NAME: &'static str;\n\n    /// Return number of remaining blocks.\n    ///\n    /// If result does not fit into `usize`, returns `None`.\n    fn remaining(cn: &Self::CtrNonce) -> Option<usize>;\n\n    /// Generate block for given `nonce` and current counter value.\n    fn next_block(cn: &mut Self::CtrNonce) -> Array<u8, B>;\n\n    /// Generate block for given `nonce` and current counter value.\n    fn current_block(cn: &Self::CtrNonce) -> Array<u8, B>;\n\n    /// Initialize from bytes.\n    fn from_nonce(block: &Array<u8, B>) -> Self::CtrNonce;\n\n    /// Convert from a backend value\n    fn set_from_backend(cn: &mut Self::CtrNonce, v: Self::Backend);\n\n    /// Convert to a backend value\n    fn as_backend(cn: &Self::CtrNonce) -> Self::Backend;\n}","attr_info":{"attributes":[{"DocComment":" Trait implemented by different CTR flavors."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null,"diagnostic_item":null},"src":"Normal","generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"B","variance":"Unknown"},{"index":2,"name":"Self_CtrNonce","variance":"Invariant"},{"index":3,"name":"Self_Backend","variance":"Invariant"},{"index":4,"name":"Self_Clause2_Clause0_Error","variance":"Invariant"},{"index":5,"name":"Self_Clause2_Clause1_Error","variance":"Invariant"},{"index":6,"name":"Self_Clause2_Clause2_Error","variance":"Invariant"},{"index":7,"name":"Self_Clause2_Clause3_Error","variance":"Invariant"},{"index":8,"name":"Self_Clause2_Clause4_Error","variance":"Invariant"},{"index":9,"name":"Self_Clause2_Clause5_Error","variance":"Invariant"},{"index":10,"name":"Self_Clause2_Clause6_Error","variance":"Invariant"},{"index":11,"name":"Self_Clause2_Clause7_Error","variance":"Invariant"},{"index":12,"name":"Self_Clause2_Clause8_Error","