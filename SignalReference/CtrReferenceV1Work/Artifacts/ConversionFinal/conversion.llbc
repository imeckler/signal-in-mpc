{"charon_version":"0.1.245","translated":{"crate_name":"ctr","options":{"ullbc":false,"precise_drops":false,"mir":null,"rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["{impl crate::flavors::CtrFlavor for crate::flavors::ctr32::Ctr32BE}::remaining"],"start_from_if_exists":["crate::flavors::ctr32::*::remaining"],"start_from_attribute":[],"start_from_pub":false,"include":["core::convert","core::result"],"opaque":["core::result::*::ok","hybrid_array::Array"],"exclude":["hybrid_array::traits::ArraySize"],"extract_opaque_bodies":false,"translate_all_methods":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"raw_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_asserts":true,"deallocate_all_locals":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"dest_dir":null,"dest_file":"/Users/izzy/repos/tls-mpc/SignalReference/CtrReferenceV1Work/Artifacts/remaining_pinned_v1/ctr.llbc","no_dedup_serialized_ast":true,"format":null,"no_serialize":false,"skip_borrowck":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"abort_on_error":false,"error_on_warnings":true,"preset":"Aeneas"},"target_information":[{"key":"aarch64-apple-darwin","value":{"target_pointer_size":8,"is_little_endian":true,"c_enum_smallest_repr_ty":"I32","primitive_alignments":[{"key":"Bool","value":1},{"key":{"Int":"I8"},"value":1},{"key":{"Int":"I16"},"value":2},{"key":{"Int":"I32"},"value":4},{"key":{"Int":"I64"},"value":8},{"key":{"Int":"I128"},"value":16},{"key":{"Int":"Isize"},"value":8},{"key":{"UInt":"U8"},"value":1},{"key":{"UInt":"U16"},"value":2},{"key":{"UInt":"U32"},"value":4},{"key":{"UInt":"U64"},"value":8},{"key":{"UInt":"U128"},"value":16},{"key":{"UInt":"Usize"},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"files":[{"id":0,"name":{"Local":"src/flavors/ctr32.rs"},"crate_name":"ctr","contents":"//! 32-bit counter flavors.\nuse super::CtrFlavor;\nuse cipher::{\n    array::{Array, ArraySize},\n    typenum::{PartialDiv, PartialQuot, U4, Unsigned},\n};\nuse core::fmt;\n\ntype ChunkSize = U4;\ntype Chunks<B> = PartialQuot<B, ChunkSize>;\nconst CS: usize = ChunkSize::USIZE;\n\n#[derive(Clone)]\npub struct CtrNonce32<N: ArraySize> {\n    ctr: u32,\n    nonce: Array<u32, N>,\n}\n\nimpl<N: ArraySize> fmt::Debug for CtrNonce32<N> {\n    #[inline]\n    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {\n        f.write_str(\"CtrNonce32 { ... }\")\n    }\n}\n\nimpl<N: ArraySize> Drop for CtrNonce32<N> {\n    fn drop(&mut self) {\n        #[cfg(feature = \"zeroize\")]\n        {\n            use cipher::zeroize::Zeroize;\n            self.ctr.zeroize();\n            self.nonce.zeroize();\n        }\n    }\n}\n\n#[cfg(feature = \"zeroize\")]\nimpl<N: ArraySize> cipher::zeroize::ZeroizeOnDrop for CtrNonce32<N> {}\n\n/// 32-bit big endian counter flavor.\n#[derive(Clone, Copy, Debug)]\npub enum Ctr32BE {}\n\nimpl<B> CtrFlavor<B> for Ctr32BE\nwhere\n    B: ArraySize + PartialDiv<ChunkSize>,\n    Chunks<B>: ArraySize,\n{\n    type CtrNonce = CtrNonce32<Chunks<B>>;\n    type Backend = u32;\n    const NAME: &'static str = \"32BE\";\n\n    #[inline]\n    fn remaining(cn: &Self::CtrNonce) -> Option<usize> {\n        (u32::MAX - cn.ctr).try_into().ok()\n    }\n\n    #[inline(always)]\n    fn current_block(cn: &Self::CtrNonce) -> Array<u8, B> {\n        let mut block = Array::<u8, B>::default();\n        for i in 0..Chunks::<B>::USIZE {\n            let t = if i == Chunks::<B>::USIZE - 1 {\n                cn.ctr.wrapping_add(cn.nonce[i]).to_be_bytes()\n            } else {\n                cn.nonce[i].to_ne_bytes()\n            };\n            block[CS * i..][..CS].copy_from_slice(&t);\n        }\n        block\n    }\n\n    #[inline]\n    fn next_block(cn: &mut Self::CtrNonce) -> Array<u8, B> {\n        let block = Self::current_block(cn);\n        cn.ctr = cn.ctr.wrapping_add(1);\n        block\n    }\n\n    #[inline]\n    fn from_nonce(block: &Array<u8, B>) -> Self::CtrNonce {\n        let mut nonce = Array::<u32, Chunks<B>>::default();\n        for i in 0..Chunks::<B>::USIZE {\n            let chunk = block[CS * i..][..CS]\n                .try_into()\n                .expect(\"should be the correct size\");\n            nonce[i] = if i == Chunks::<B>::USIZE - 1 {\n                u32::from_be_bytes(chunk)\n            } else {\n                u32::from_ne_bytes(chunk)\n            }\n        }\n        let ctr = 0;\n        Self::CtrNonce { ctr, nonce }\n    }\n\n    #[inline]\n    fn as_backend(cn: &Self::CtrNonce) -> Self::Backend {\n        cn.ctr\n    }\n\n    #[inline]\n    fn set_from_backend(cn: &mut Self::CtrNonce, v: Self::Backend) {\n        cn.ctr = v;\n    }\n}\n\n/// 32-bit little endian counter flavor.\n#[derive(Clone, Copy, Debug)]\npub enum Ctr32LE {}\n\nimpl<B> CtrFlavor<B> for Ctr32LE\nwhere\n    B: ArraySize + PartialDiv<ChunkSize>,\n    Chunks<B>: ArraySize,\n{\n    type CtrNonce = CtrNonce32<Chunks<B>>;\n    type Backend = u32;\n    const NAME: &'static str = \"32LE\";\n\n    #[inline]\n    fn remaining(cn: &Self::CtrNonce) -> Option<usize> {\n        (u32::MAX - cn.ctr).try_into().ok()\n    }\n\n    #[inline(always)]\n    fn current_block(cn: &Self::CtrNonce) -> Array<u8, B> {\n        let mut block = Array::<u8, B>::default();\n        for i in 0..Chunks::<B>::USIZE {\n            let t = if i == 0 {\n                cn.ctr.wrapping_add(cn.nonce[i]).to_le_bytes()\n            } else {\n                cn.nonce[i].to_ne_bytes()\n            };\n            block[CS * i..][..CS].copy_from_slice(&t);\n        }\n        block\n    }\n\n    #[inline]\n    fn next_block(cn: &mut Self::CtrNonce) -> Array<u8, B> {\n        let block = Self::current_block(cn);\n        cn.ctr = cn.ctr.wrapping_add(1);\n        block\n    }\n\n    #[inline]\n    fn from_nonce(block: &Array<u8, B>) -> Self::CtrNonce {\n        let mut nonce = Array::<u32, Chunks<B>>::default();\n        for i in 0..Chunks::<B>::USIZE {\n            let chunk = block[CS * i..][..CS]\n                .try_into()\n                .expect(\"should be the correct size\");\n            nonce[i] = if i == 0 {\n                u32::from_le_bytes(chunk)\n            } else {\n                u32::from_ne_bytes(chunk)\n            }\n        }\n        let ctr = 0;\n        Self::CtrNonce { ctr, nonce }\n    }\n\n    #[inline]\n    fn as_backend(cn: &Self::CtrNonce) -> Self::Backend {\n        cn.ctr\n    }\n\n    #[inline]\n    fn set_from_backend(cn: &mut Self::CtrNonce, v: Self::Backend) {\n        cn.ctr = v;\n    }\n}\n"},{"id":1,"name":{"Local":"src/flavors.rs"},"crate_name":"ctr","contents":"//! CTR mode flavors\n\nuse cipher::{\n    StreamCipherCounter,\n    array::{Array, ArraySize},\n};\n\nmod ctr128;\nmod ctr32;\nmod ctr64;\n\npub use ctr32::{Ctr32BE, Ctr32LE};\npub use ctr64::{Ctr64BE, Ctr64LE};\npub use ctr128::{Ctr128BE, Ctr128LE};\n\n/// Trait implemented by different CTR flavors.\npub trait CtrFlavor<B: ArraySize> {\n    /// Inner representation of nonce.\n    type CtrNonce: Clone;\n    /// Backend numeric type\n    type Backend: StreamCipherCounter;\n    /// Flavor name\n    const NAME: &'static str;\n\n    /// Return number of remaining blocks.\n    ///\n    /// If result does not fit into `usize`, returns `None`.\n    fn remaining(cn: &Self::CtrNonce) -> Option<usize>;\n\n    /// Generate block for given `nonce` and current counter value.\n    fn next_block(cn: &mut Self::CtrNonce) -> Array<u8, B>;\n\n    /// Generate block for given `nonce` and current counter value.\n    fn current_block(cn: &Self::CtrNonce) -> Array<u8, B>;\n\n    /// Initialize from bytes.\n    fn from_nonce(block: &Array<u8, B>) -> Self::CtrNonce;\n\n    /// Convert from a backend value\n    fn set_from_backend(cn: &mut Self::CtrNonce, v: Self::Backend);\n\n    /// Convert to a backend value\n    fn as_backend(cn: &Self::CtrNonce) -> Self::Backend;\n}\n"},{"id":2,"name":{"Local":"src/lib.rs"},"crate_name":"ctr","contents":"//! Generic implementations of [CTR mode][1] for block ciphers.\n//!\n//! <img src=\"https://raw.githubusercontent.com/RustCrypto/media/26acc39f/img/block-modes/ctr_enc.svg\" width=\"49%\" />\n//! <img src=\"https://raw.githubusercontent.com/RustCrypto/media/26acc39f/img/block-modes/ctr_dec.svg\" width=\"49%\"/>\n//!\n//! Mode functionality is accessed using traits from re-exported [`cipher`] crate.\n//!\n//! # \u26a0\ufe0f Security Warning: Hazmat!\n//!\n//! This crate does not ensure ciphertexts are authentic! Thus ciphertext integrity\n//! is not verified, which can lead to serious vulnerabilities!\n//! [RustCrypto/AEADs] provide simple authenticated encryption,\n//! which is much less error-prone than manual integrity verification.\n//!\n//! [RustCrypto/AEADs]: https://github.com/RustCrypto/AEADs\n//!\n//! # Example\n//! ```\n//! use aes::cipher::{KeyIvInit, StreamCipher, StreamCipherSeek};\n//! use hex_literal::hex;\n//!\n//! type Aes128Ctr64LE = ctr::Ctr64LE<aes::Aes128>;\n//!\n//! let key = [0x42; 16];\n//! let iv = [0x24; 16];\n//! let plaintext = *b\"hello world! this is my plaintext.\";\n//! let ciphertext = hex!(\n//!     \"3357121ebb5a29468bd861467596ce3da59bdee42dcc0614dea955368d8a5dc0cad4\"\n//! );\n//!\n//! // encrypt in-place\n//! let mut buf = plaintext.to_vec();\n//! let mut cipher = Aes128Ctr64LE::new(&key.into(), &iv.into());\n//! cipher.apply_keystream(&mut buf);\n//! assert_eq!(buf[..], ciphertext[..]);\n//!\n//! // CTR mode can be used with streaming messages\n//! let mut cipher = Aes128Ctr64LE::new(&key.into(), &iv.into());\n//! for chunk in buf.chunks_mut(3) {\n//!     cipher.apply_keystream(chunk);\n//! }\n//! assert_eq!(buf[..], plaintext[..]);\n//!\n//! // CTR mode supports seeking. The parameter is zero-based _bytes_ counter (not _blocks_).\n//! cipher.seek(0u32);\n//!\n//! // encrypt/decrypt from buffer to buffer\n//! // buffer length must be equal to input length\n//! let mut buf1 = [0u8; 34];\n//! cipher.apply_keystream_b2b(&plaintext, &mut buf1);\n//! assert_eq!(buf1[..], ciphertext[..]);\n//!\n//! let mut buf2 = [0u8; 34];\n//! cipher.seek(0u32);\n//! cipher.apply_keystream_b2b(&buf1, &mut buf2);\n//! assert_eq!(buf2[..], plaintext[..]);\n//! ```\n//!\n//! [1]: https://en.wikipedia.org/wiki/Block_cipher_mode_of_operation#CTR\n\n#![no_std]\n#![doc(\n    html_logo_url = \"https://raw.githubusercontent.com/RustCrypto/media/6ee8e381/logo.svg\",\n    html_favicon_url = \"https://raw.githubusercontent.com/RustCrypto/media/6ee8e381/logo.svg\"\n)]\n#![forbid(unsafe_code)]\n#![cfg_attr(docsrs, feature(doc_cfg))]\n#![warn(missing_debug_implementations, missing_docs, rust_2018_idioms)]\n\nmod ctr_core;\npub mod flavors;\n\npub use cipher;\npub use flavors::CtrFlavor;\n\nuse cipher::StreamCipherCoreWrapper;\npub use ctr_core::CtrCore;\n\n/// CTR mode with 128-bit big endian counter.\npub type Ctr128BE<B> = StreamCipherCoreWrapper<CtrCore<B, flavors::Ctr128BE>>;\n/// CTR mode with 128-bit little endian counter.\npub type Ctr128LE<B> = StreamCipherCoreWrapper<CtrCore<B, flavors::Ctr128LE>>;\n/// CTR mode with 64-bit big endian counter.\npub type Ctr64BE<B> = StreamCipherCoreWrapper<CtrCore<B, flavors::Ctr64BE>>;\n/// CTR mode with 64-bit little endian counter.\npub type Ctr64LE<B> = StreamCipherCoreWrapper<CtrCore<B, flavors::Ctr64LE>>;\n/// CTR mode with 32-bit big endian counter.\npub type Ctr32BE<B> = StreamCipherCoreWrapper<CtrCore<B, flavors::Ctr32BE>>;\n/// CTR mode with 32-bit little endian counter.\npub type Ctr32LE<B> = StreamCipherCoreWrapper<CtrCore<B, flavors::Ctr32LE>>;\n"},{"id":3,"name":{"Local":"/Users/izzy/repos/tls-mpc/.deps/libsignal-vendor/hybrid-array-0.4.13/src/traits.rs"},"crate_name":"hybrid_array","contents":null},{"id":4,"name":{"Local":"/Users/izzy/repos/tls-mpc/.deps/libsignal-vendor/hybrid-array-0.4.13/src/lib.rs"},"crate_name":"hybrid_array","contents":null},{"id":5,"name":{"Local":"/Users/izzy/repos/tls-mpc/.deps/libsignal-vendor/typenum-1.20.1/src/type_operators.rs"},"crate_name":"typenum","contents":null},{"id":6,"name":{"Local":"/Users/izzy/repos/tls-mpc/.deps/libsignal-vendor/typenum-1.20.1/src/lib.rs"},"crate_name":"typenum","contents":null},{"id":7,"name":{"Local":"/Users/izzy/repos/tls-mpc/.deps/libsignal-vendor/typenum-1.20.1/src/uint.rs"},"crate_name":"typenum","contents":null},{"id":8,"name":{"Local":"/Users/izzy/repos/tls-mpc/.deps/libsignal-vendor/typenum-1.20.1/src/bit.rs"},"crate_name":"typenum","contents":null},{"id":9,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":10,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":11,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":12,"name":{"Local":"/Users/izzy/repos/tls-mpc/.deps/libsignal-vendor/typenum-1.20.1/src/marker_traits.rs"},"crate_name":"typenum","contents":null},{"id":13,"name":{"Local":"/Users/izzy/repos/tls-mpc/.deps/libsignal-vendor/cipher-0.5.2/src/stream/core_api.rs"},"crate_name":"cipher","contents":null},{"id":14,"name":{"Local":"/Users/izzy/repos/tls-mpc/.deps/libsignal-vendor/cipher-0.5.2/src/stream.rs"},"crate_name":"cipher","contents":null},{"id":15,"name":{"Local":"/Users/izzy/repos/tls-mpc/.deps/libsignal-vendor/cipher-0.5.2/src/lib.rs"},"crate_name":"cipher","contents":null},{"id":16,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":17,"name":{"Local":"/rustc/library/core/src/result.rs"},