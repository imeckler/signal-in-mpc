l}],"trait_impls":[{"def_id":0,"item_meta":{"name":[{"Ident":["ctr",0]},{"Ident":["flavors",0]},{"Ident":["ctr32",0]},{"Impl":{"Trait":0}}],"span":{"data":{"file_id":0,"beg":{"line":44,"col":0},"end":{"line":105,"col":1}},"generated_from_span":null},"source_text":"impl<B> CtrFlavor<B> for Ctr32BE\nwhere\n    B: ArraySize + PartialDiv<ChunkSize>,\n    Chunks<B>: ArraySize,\n{\n    type CtrNonce = CtrNonce32<Chunks<B>>;\n    type Backend = u32;\n    const NAME: &'static str = \"32BE\";\n\n    #[inline]\n    fn remaining(cn: &Self::CtrNonce) -> Option<usize> {\n        (u32::MAX - cn.ctr).try_into().ok()\n    }\n\n    #[inline(always)]\n    fn current_block(cn: &Self::CtrNonce) -> Array<u8, B> {\n        let mut block = Array::<u8, B>::default();\n        for i in 0..Chunks::<B>::USIZE {\n            let t = if i == Chunks::<B>::USIZE - 1 {\n                cn.ctr.wrapping_add(cn.nonce[i]).to_be_bytes()\n            } else {\n                cn.nonce[i].to_ne_bytes()\n            };\n            block[CS * i..][..CS].copy_from_slice(&t);\n        }\n        block\n    }\n\n    #[inline]\n    fn next_block(cn: &mut Self::CtrNonce) -> Array<u8, B> {\n        let block = Self::current_block(cn);\n        cn.ctr = cn.ctr.wrapping_add(1);\n        block\n    }\n\n    #[inline]\n    fn from_nonce(block: &Array<u8, B>) -> Self::CtrNonce {\n        let mut nonce = Array::<u32, Chunks<B>>::default();\n        for i in 0..Chunks::<B>::USIZE {\n            let chunk = block[CS * i..][..CS]\n                .try_into()\n                .expect(\"should be the correct size\");\n            nonce[i] = if i == Chunks::<B>::USIZE - 1 {\n                u32::from_be_bytes(chunk)\n            } else {\n                u32::from_ne_bytes(chunk)\n            }\n        }\n        let ctr = 0;\n        Self::CtrNonce { ctr, nonce }\n    }\n\n    #[inline]\n    fn as_backend(cn: &Self::CtrNonce) -> Self::Backend {\n        cn.ctr\n    }\n\n    #[inline]\n    fn set_from_backend(cn: &mut Self::CtrNonce, v: Self::Backend) {\n        cn.ctr = v;\n    }\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"opacity":"Transparent","lang_item":null,"diagnostic_item":null},"src":"Normal","impl_trait":{"id":2,"generics":{"regions":[],"types":[{"Untagged":{"Adt":{"id":{"Adt":4},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}},{"Untagged":{"TypeVar":{"Free":0}}},{"Untagged":{"Adt":{"id":{"Adt":5},"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":1}}}],"const_generics":[],"trait_refs":[]}}}},{"Untagged":{"Literal":{"UInt":"U32"}}},{"Untagged":{"Adt":{"id":{"Adt":8},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}},{"Untagged":{"Adt":{"id":{"Adt":16},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}},{"Untagged":{"Adt":{"id":{"Adt":8},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}},{"Untagged":{"Adt":{"id":{"Adt":8},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}},{"Untagged":{"Adt":{"id":{"Adt":8},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}},{"Untagged":{"Adt":{"id":{"Adt":8},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}},{"Untagged":{"Adt":{"id":{"Adt":16},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}},{"Untagged":{"Adt":{"id":{"Adt":16},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}},{"Untagged":{"Adt":{"id":{"Adt":16},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}},{"Untagged":{"Adt":{"id":{"Adt":8},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}}],"const_generics":[],"trait_refs":[]}},"generics":{"regions":[],"types":[{"index":0,"name":"B","variance":"Unknown"},{"index":1,"name":"Clause1_Output","variance":"Invariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":0,"beg":{