import TlsMpcProofs.EdwardsEd25519
import TlsMpcProofs.OffsetSampling
import TlsMpcProofs.Hiding

/-!
# The base point has order exactly `ℓ`; the offset theorems for the curve

* `base_onCurve`: the main package's base point `(baseX, baseY)` is on the curve.
* `order_nsmul_base`: **`ℓ·B = 0`**, by a double-and-add in extended coordinates over `ℕ` modulo
  `p` that the kernel evaluates (`decide +kernel` on `Nat` arithmetic only, as in `Prime25519`);
  `castT_smulN` and `Edwards.rep4_smul` prove that this computation is the scalar multiple in the
  group `Curve`.
* `addOrderOf_base`: with `ℓ` prime (`OffsetSampling.prime_order`) and `B ≠ 0`, **the order of
  `B` is exactly `ℓ`**; `card_zmultiples_base`: the subgroup generated by `B` has exactly `ℓ`
  elements. The same for any point `P ≠ 0` with `ℓ·P = 0` (`card_zmultiples_of_order`).
* The offset-agreement theorems (which take "a finite commutative group of order `ℓ`" as
  hypothesis H-GROUP) instantiated with that subgroup: `curve_public_key_independent`,
  `curve_public_key_uniform`, `curve_key_close`, `curve_key_close_uniform`, `curve_keys_close`,
  and for the base point `base_key_close_uniform`, `base_keys_close`. The masked-point theorems
  (P-HINT(c), the masked agreement), which need any finite commutative group, instantiated with
  the whole curve: `curve_hinted_Z_uniform`, `curve_maskedAgreement_mask_hides`.

Not proved: `#Curve = 8ℓ` (point counting). It is not needed above: the statements are about the
subgroup generated by a point of order `ℓ`.
-/

namespace TlsMpcProofs.Ed25519
open TlsMpc Edwards

/-! ### Extended addition over `ℕ` modulo `m`, for the kernel -/

/-- `a − b` modulo `m`, without leaving `ℕ`. -/
def subN (m a b : ℕ) : ℕ := a + (m - b % m)

/-- `Edwards.extAdd 121666 121665` on residues. -/
def eaddN (m : ℕ) (p q : ℕ × ℕ × ℕ × ℕ) : ℕ × ℕ × ℕ × ℕ :=
  let a := subN m p.2.1 p.1 * subN m q.2.1 q.1 % m
  let b := (p.2.1 + p.1) * (q.2.1 + q.1) % m
  let cc := 2 * 121665 * (p.2.2.2 * q.2.2.2) % m
  let dd := 2 * 121666 * (p.2.2.1 * q.2.2.1) % m
  let e := 121666 * subN m b a % m
  let h := 121666 * (b + a) % m
  let f := (dd + cc) % m
  let g := subN m dd cc % m
  (e * f % m, g * h % m, f * g % m, e * h % m)

/-- `Edwards.extSmul` on residues: double-and-add over `k` bits of `e`. -/
def smulN (m : ℕ) (b : ℕ × ℕ × ℕ × ℕ) (e : ℕ) : ℕ → ℕ × ℕ × ℕ × ℕ
  | 0 => (0, 1, 1, 0)
  | k + 1 =>
    if e % 2 = 1 then eaddN m (eaddN m (smulN m b (e / 2) k) (smulN m b (e / 2) k)) b
    else eaddN m (smulN m b (e / 2) k) (smulN m b (e / 2) k)

/-- Residues as elements of `ZMod p`. -/
def castT (p : ℕ × ℕ × ℕ × ℕ) : K × K × K × K :=
  ((p.1 : K), (p.2.1 : K), (p.2.2.1 : K), (p.2.2.2 : K))

theorem subN_cast (a b : ℕ) : ((subN FieldDag.modulus a b : ℕ) : K) = (a : K) - (b : K) := by
  unfold subN
  rw [Nat.cast_add, Nat.cast_sub (Nat.mod_lt _ (by decide)).le, ZMod.natCast_self,
    ZMod.natCast_mod]
  ring

theorem castT_eaddN (p q : ℕ × ℕ × ℕ × ℕ) :
    castT (eaddN FieldDag.modulus p q) = Edwards.extAdd 121666 121665 (castT p) (castT q) := by
  simp only [castT, eaddN, Edwards.extAdd, Nat.cast_mul, Nat.cast_add, ZMod.natCast_mod, subN_cast,
    Nat.cast_ofNat]

theorem castT_smulN (b : ℕ × ℕ × ℕ × ℕ) (e k : ℕ) :
    castT (smulN FieldDag.modulus b e k) = Edwards.extSmul 121666 121665 (castT b) e k := by
  induction k generalizing e with
  | zero => simp [smulN, Edwards.extSmul, castT]
  | succ k ih =>
    unfold smulN Edwards.extSmul
    split_ifs <;> simp only [castT_eaddN, ih]

theorem rep4_castT_eq_zero {p : ℕ × ℕ × ℕ × ℕ} {P : Curve} (h : Rep4 (castT p) P)
    (hx : p.1 = 0) (hy : p.2.1 = p.2.2.1) : P = 0 :=
  rep4_eq_zero h (by simp [castT, hx]) (by simp [castT, hy])

/-! ### The base point -/

/-- **The base point is on the curve** (the equation scaled by 121666, checked on residues). -/
theorem base_onCurve :
    OnCurve dK ((EdwardsHinted.baseX : ℕ) : K) ((EdwardsHinted.baseY : ℕ) : K) := by
  have h : ((121666 * EdwardsHinted.baseY ^ 2 +
        121665 * (EdwardsHinted.baseX ^ 2 * EdwardsHinted.baseY ^ 2) : ℕ) : K) =
      ((121666 * (EdwardsHinted.baseX ^ 2 + 1) : ℕ) : K) := by
    rw [ZMod.natCast_eq_natCast_iff']
    decide +kernel
  push_cast at h
  generalize ((EdwardsHinted.baseX : ℕ) : K) = x at h ⊢
  generalize ((EdwardsHinted.baseY : ℕ) : K) = y at h ⊢
  have h1 : (121666 : K) * (-x ^ 2 + y ^ 2 - (1 + dK * x ^ 2 * y ^ 2)) = 0 := by
    linear_combination h - x ^ 2 * y ^ 2 * dK_mul
  have h2 := (mul_eq_zero.mp h1).resolve_left c121666_ne_zero
  unfold OnCurve
  linear_combination h2

/-- The Ed25519 base point (the main package's `EdwardsHinted.baseX`, `baseY`; also
`XEdDsaField.baseX`, `baseY`), as an element of the curve group. -/
def B : Curve := ⟨((EdwardsHinted.baseX : ℕ) : K), ((EdwardsHinted.baseY : ℕ) : K), base_onCurve⟩

theorem base_eq_xeddsa : EdwardsHinted.baseX = Signal.XEdDsaField.baseX ∧
    EdwardsHinted.baseY = Signal.XEdDsaField.baseY := ⟨rfl, rfl⟩

/-- The base point in extended coordinates, on residues. -/
def baseN : ℕ × ℕ × ℕ × ℕ :=
  (EdwardsHinted.baseX, EdwardsHinted.baseY, 1,
    EdwardsHinted.baseX * EdwardsHinted.baseY % FieldDag.modulus)

theorem rep_base : Rep4 (castT baseN) B := by
  refine ⟨?_, ?_, ?_, ?_⟩ <;> simp [castT, baseN, B, ZMod.natCast_mod]

/-- `ℓ·B` in extended coordinates, evaluated by the kernel: `X = 0` and `Y = Z`. -/
theorem order_smul_computed :
    (smulN FieldDag.modulus baseN Signal.XEdDsaScalar.order 253).1 = 0 ∧
      (smulN FieldDag.modulus baseN Signal.XEdDsaScalar.order 253).2.1 =
        (smulN FieldDag.modulus baseN Signal.XEdDsaScalar.order 253).2.2.1 := by
  decide +kernel

/-- **`ℓ·B = 0` in the curve group.** -/
theorem order_nsmul_base : Signal.XEdDsaScalar.order • B = 0 := by
  have hrep := rep4_smul c121666_ne_zero dK_mul rep_base 253 Signal.XEdDsaScalar.order (by decide)
  rw [← castT_smulN] at hrep
  exact rep4_castT_eq_zero hrep order_smul_computed.1 order_smul_computed.2

theorem base_ne_zero : B ≠ 0 := by
  intro h
  have hx : ((EdwardsHinted.baseX : ℕ) : K) = 0 := congrArg Point.x h
  rw [ZMod.natCast_eq_zero_iff] at hx
  revert hx
  decide

/-- **The base point has order exactly `ℓ`** (`ℓ·B = 0`, `B ≠ 0`, `ℓ` prime). -/
theorem addOrderOf_base : addOrderOf B = Signal.XEdDsaScalar.order :=
  addOrderOf_eq_prime order_nsmul_base base_ne_zero

/-! ### The subgroup of order `ℓ` -/

noncomputable instance : Fintype Curve :=
  Fintype.ofInjective (fun P : Curve => (P.x, P.y))
    (fun _ _ h => Point.ext (congrArg Prod.fst h) (congrArg Prod.snd h))

noncomputable instance (P : Curve) : Fintype (AddSubgroup.zmultiples P) := Fintype.ofFinite _

/-- **A nonzero point killed by `ℓ` generates a subgroup with exactly `ℓ` elements.** -/
theorem card_zmultiples_of_order {P : Curve} (h : Signal.XEdDsaScalar.order • P = 0) (hP : P ≠ 0) :
    Fintype.card (AddSubgroup.zmultiples P) = Signal.XEdDsaScalar.order := by
  rw [Fintype.card_eq_nat_card, Nat.card_zmultiples, addOrderOf_eq_prime h hP]

/-- **The subgroup generated by the base point has exactly `ℓ` elements.** -/
theorem card_zmultiples_base :
    Fintype.card (AddSubgroup.zmultiples B) = Signal.XEdDsaScalar.order :=
  card_zmultiples_of_order order_nsmul_base base_ne_zero

/-- A point as an element of the subgroup it generates. -/
def gen (P : Curve) : AddSubgroup.zmultiples P := ⟨P, AddSubgroup.mem_zmultiples P⟩

theorem gen_ne_zero {P : Curve} (hP : P ≠ 0) : gen P ≠ 0 := by
  intro h
  exact hP (congrArg Subtype.val h)

/-! ### H-GROUP discharged in the offset-agreement theorems

`P` is any curve point with `ℓ·P = 0`, `P ≠ 0` (for instance the base point; for a recipient's
key the two conditions are what the torsion check establishes). The group is the subgroup `P`
generates; no hypothesis about a group remains. -/

section Offset
open TlsMpcProofs.OffsetAgreement TlsMpcProofs.OffsetSampling

variable {P : Curve} (h : Signal.XEdDsaScalar.order • P = 0) (hP : P ≠ 0)
include h hP

/-- The published key `initial·P + offset·P` (offset uniform mod `ℓ`) has the same distribution
for any two initial scalars. -/
theorem curve_public_key_independent (initial other : ZMod Signal.XEdDsaScalar.order) :
    PMF.map (publicKey (gen P) initial) (PMF.uniformOfFintype (ZMod Signal.XEdDsaScalar.order)) =
      PMF.map (publicKey (gen P) other) (PMF.uniformOfFintype (ZMod Signal.XEdDsaScalar.order)) :=
  offset_public_key_independent (card_zmultiples_of_order h hP) (gen P) initial other

/-- … and is uniform on the subgroup. -/
theorem curve_public_key_uniform (initial : ZMod Signal.XEdDsaScalar.order) :
    PMF.map (publicKey (gen P) initial) (PMF.uniformOfFintype (ZMod Signal.XEdDsaScalar.order)) =
      PMF.uniformOfFintype (AddSubgroup.zmultiples P) :=
  offset_public_key_uniform (card_zmultiples_of_order h hP) (gen P) (gen_ne_zero hP) initial

/-- Deployed sampling, one message: any two initial scalars, every event within `2⁻¹²⁷`. -/
theorem curve_key_close (peer : BitVec 256) (initial other : ZMod Signal.XEdDsaScalar.order) :
    EventClose
      (PMF.map (fun mine => deployedKey (gen P) initial (deployedOffset mine peer))
        (PMF.uniformOfFintype (BitVec 256)))
      (PMF.map (fun mine => deployedKey (gen P) other (deployedOffset mine peer))
        (PMF.uniformOfFintype (BitVec 256)))
      (1 / ((2 ^ 127 : ℕ) : ENNReal)) :=
  ed25519_key_close (card_zmultiples_of_order h hP) (gen P) peer initial other

/-- Deployed sampling, one message: the key is within `2⁻¹²⁷` of uniform on the subgroup. -/
theorem curve_key_close_uniform (peer : BitVec 256) (initial : ZMod Signal.XEdDsaScalar.order) :
    StatClose
      (PMF.map (fun mine => deployedKey (gen P) initial (deployedOffset mine peer))
        (PMF.uniformOfFintype (BitVec 256)))
      (PMF.uniformOfFintype (AddSubgroup.zmultiples P)) (1 / ((2 ^ 127 : ℕ) : ENNReal)) :=
  ed25519_key_close_uniform (card_zmultiples_of_order h hP) (gen P) (gen_ne_zero hP) peer initial

/-- Deployed sampling, `k` messages: the joint keys, any two initial scalars, within `k·2⁻¹²⁷`. -/
theorem curve_keys_close {k : ℕ} (peers : Fin k → BitVec 256)
    (initial other : ZMod Signal.XEdDsaScalar.order) :
    EventClose
      (PMF.map (fun mines => deployedKeys (gen P) initial (deployedOffsets peers mines))
        (PMF.uniformOfFintype (Fin k → BitVec 256)))
      (PMF.map (fun mines => deployedKeys (gen P) other (deployedOffsets peers mines))
        (PMF.uniformOfFintype (Fin k → BitVec 256)))
      (k * (1 / ((2 ^ 127 : ℕ) : ENNReal))) :=
  ed25519_keys_close (card_zmultiples_of_order h hP) (gen P) peers initial other

end Offset

section Base
open TlsMpcProofs.OffsetAgreement TlsMpcProofs.OffsetSampling

/-- **For the base point, with no hypothesis:** the deployed key `initial·B + offset·B` is within
`2⁻¹²⁷` of uniform on the subgroup generated by `B` (which has exactly `ℓ` elements). -/
theorem base_key_close_uniform (peer : BitVec 256) (initial : ZMod Signal.XEdDsaScalar.order) :
    StatClose
      (PMF.map (fun mine => deployedKey (gen B) initial (deployedOffset mine peer))
        (PMF.uniformOfFintype (BitVec 256)))
      (PMF.uniformOfFintype (AddSubgroup.zmultiples B)) (1 / ((2 ^ 127 : ℕ) : ENNReal)) :=
  curve_key_close_uniform order_nsmul_base base_ne_zero peer initial

/-- **For the base point, `k` messages, with no hypothesis.** -/
theorem base_keys_close {k : ℕ} (peers : Fin k → BitVec 256)
    (initial other : ZMod Signal.XEdDsaScalar.order) :
    EventClose
      (PMF.map (fun mines => deployedKeys (gen B) initial (deployedOffsets peers mines))
        (PMF.uniformOfFintype (Fin k → BitVec 256)))
      (PMF.map (fun mines => deployedKeys (gen B) other (deployedOffsets peers mines))
        (PMF.uniformOfFintype (Fin k → BitVec 256)))
      (k * (1 / ((2 ^ 127 : ℕ) : ENNReal))) :=
  curve_keys_close order_nsmul_base base_ne_zero peers initial other

end Base

/-! ### The masked-point theorems on the whole curve -/

/-- **P-HINT(c) on the curve:** `Z = P + M_A + M_B` is uniform on the curve group for the honest
party's uniform curve point `M_B`. -/
theorem curve_hinted_Z_uniform (P maskA : Curve) :
    PMF.map (fun maskB => MaskedAgreement.opened P maskA maskB) (PMF.uniformOfFintype Curve) =
      PMF.uniformOfFintype Curve :=
  TlsMpcProofs.hinted_Z_uniform P maskA

/-- **The masked agreement's opened point on the curve** has the same distribution for any two
points `R`. -/
theorem curve_maskedAgreement_mask_hides (R other maskA : Curve) :
    PMF.map (fun maskB => MaskedAgreement.opened R maskA maskB) (PMF.uniformOfFintype Curve) =
      PMF.map (fun maskB => MaskedAgreement.opened other maskA maskB) (PMF.uniformOfFintype Curve) :=
  TlsMpcProofs.maskedAgreement_mask_hides_dist R other maskA

end TlsMpcProofs.Ed25519
